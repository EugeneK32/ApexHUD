{
  "schemaVersion": 1,
  "id": "com.apexhud.race-control",
  "name": "Race Control",
  "description": "Flag priority, pit state, repairs, limiter and engine warnings in one glanceable panel.",
  "version": "5.1.0",
  "author": "Eugene Konovalov",
  "entry": "index.html",
  "scopes": [
    "session",
    "driverAids",
    "pit"
  ],
  "defaultBounds": {
    "x": 0.72,
    "y": 0.04,
    "width": 0.26,
    "height": 0.09
  },
  "minimumSize": {
    "width": 250,
    "height": 72
  },
  "settings": [
    {
      "key": "showPitState",
      "label": "Show pit status",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showRepairs",
      "label": "Show repair time",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showEngineWarnings",
      "label": "Show engine warnings",
      "type": "boolean",
      "default": true
    },
    {
      "key": "flashCritical",
      "label": "Pulse red and checkered flags",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showDemoInEditor",
      "label": "Show demo data in editor",
      "type": "boolean",
      "default": true
    },
    {
      "key": "panelColor",
      "label": "Panel color",
      "type": "color",
      "default": "#08090b"
    },
    {
      "key": "panelOpacity",
      "label": "Panel opacity",
      "type": "range",
      "default": 0.94,
      "min": 0.2,
      "max": 1,
      "step": 0.02
    },
    {
      "key": "idleColor",
      "label": "Clear-track color",
      "type": "color",
      "default": "#27c3e8"
    },
    {
      "key": "greenColor",
      "label": "Green flag color",
      "type": "color",
      "default": "#37d67a"
    },
    {
      "key": "yellowColor",
      "label": "Yellow flag color",
      "type": "color",
      "default": "#f2c94c"
    },
    {
      "key": "blueColor",
      "label": "Blue flag color",
      "type": "color",
      "default": "#3f8cf4"
    },
    {
      "key": "redColor",
      "label": "Red flag color",
      "type": "color",
      "default": "#ff4d5e"
    },
    {
      "key": "whiteColor",
      "label": "White flag color",
      "type": "color",
      "default": "#f7f7f8"
    },
    {
      "key": "checkeredColor",
      "label": "Checkered accent",
      "type": "color",
      "default": "#d6d6d8"
    },
    {
      "key": "textColor",
      "label": "Primary text color",
      "type": "color",
      "default": "#f7f7f8"
    },
    {
      "key": "mutedColor",
      "label": "Secondary text color",
      "type": "color",
      "default": "#8d9098"
    },
    {
      "key": "borderColor",
      "label": "Border color",
      "type": "color",
      "default": "#2c2f35"
    },
    {
      "key": "cornerRadius",
      "label": "Corner radius",
      "type": "range",
      "default": 4,
      "min": 0,
      "max": 22,
      "step": 1
    },
    {
      "key": "fontScale",
      "label": "Typography scale",
      "type": "range",
      "default": 0.82,
      "min": 0.65,
      "max": 1.25,
      "step": 0.05
    }
  ]
}
