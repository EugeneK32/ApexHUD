{
  "schemaVersion": 1,
  "id": "com.apexhud.relative",
  "name": "Relative",
  "description": "Broadcast-style relative timing with a centered player row and nearest cars ahead and behind.",
  "version": "3.1.0",
  "author": "ApexHUD",
  "entry": "index.html",
  "scopes": [
    "session",
    "relative"
  ],
  "defaultBounds": {
    "x": 0.775,
    "y": 0.19,
    "width": 0.205,
    "height": 0.43
  },
  "minimumSize": {
    "width": 300,
    "height": 270
  },
  "settings": [
    {
      "key": "rows",
      "label": "Visible cars",
      "type": "range",
      "default": 6,
      "min": 4,
      "max": 12,
      "step": 1
    },
    {
      "key": "showNames",
      "label": "Show driver names",
      "type": "boolean",
      "default": true
    },
    {
      "key": "hideWhenEmpty",
      "label": "Hide when no nearby cars",
      "type": "boolean",
      "default": true
    },
    {
      "key": "accent",
      "label": "Header accent",
      "type": "color",
      "default": "#d64b7f"
    },
    {
      "key": "opacity",
      "label": "Panel opacity",
      "type": "range",
      "default": 0.92,
      "min": 0.3,
      "max": 1,
      "step": 0.05
    }
  ]
}
