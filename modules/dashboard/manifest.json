{
  "schemaVersion": 1,
  "id": "com.apexhud.dashboard",
  "name": "Race Dashboard",
  "description": "Premium speed, gear and shift display with live limiter, ABS, TC and brake-bias context.",
  "version": "5.1.0",
  "author": "Eugene Konovalov",
  "entry": "index.html",
  "scopes": [
    "vehicle",
    "driverAids"
  ],
  "defaultBounds": {
    "x": 0.38,
    "y": 0.86,
    "width": 0.24,
    "height": 0.095
  },
  "minimumSize": {
    "width": 240,
    "height": 74
  },
  "settings": [
    {
      "key": "speedUnit",
      "label": "Speed unit",
      "type": "select",
      "default": "kmh",
      "options": [
        {
          "label": "km/h",
          "value": "kmh"
        },
        {
          "label": "mph",
          "value": "mph"
        }
      ]
    },
    {
      "key": "shiftDisplay",
      "label": "Shift display",
      "type": "select",
      "default": "segments",
      "options": [
        {
          "label": "Segment bar",
          "value": "segments"
        },
        {
          "label": "Thin line",
          "value": "line"
        },
        {
          "label": "Hidden",
          "value": "hidden"
        }
      ]
    },
    {
      "key": "showRpm",
      "label": "Show RPM",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showAids",
      "label": "Show ABS, TC and limiter",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showBrakeBias",
      "label": "Show brake bias",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showDemoInEditor",
      "label": "Show demo data in editor",
      "type": "boolean",
      "default": true
    },
    {
      "key": "panelColor",
      "label": "Panel color",
      "type": "color",
      "default": "#08090b"
    },
    {
      "key": "panelOpacity",
      "label": "Panel opacity",
      "type": "range",
      "default": 0.94,
      "min": 0.2,
      "max": 1,
      "step": 0.02
    },
    {
      "key": "gearColor",
      "label": "Normal gear color",
      "type": "color",
      "default": "#f7f7f8"
    },
    {
      "key": "speedColor",
      "label": "Speed color",
      "type": "color",
      "default": "#f7f7f8"
    },
    {
      "key": "accentColor",
      "label": "Active accent",
      "type": "color",
      "default": "#27c3e8"
    },
    {
      "key": "warningColor",
      "label": "Approaching shift color",
      "type": "color",
      "default": "#f2c94c"
    },
    {
      "key": "shiftColor",
      "label": "Shift now color",
      "type": "color",
      "default": "#ff4d5e"
    },
    {
      "key": "positiveColor",
      "label": "Active aid color",
      "type": "color",
      "default": "#38d27a"
    },
    {
      "key": "mutedColor",
      "label": "Secondary text color",
      "type": "color",
      "default": "#8d9098"
    },
    {
      "key": "borderColor",
      "label": "Border color",
      "type": "color",
      "default": "#2c2f35"
    },
    {
      "key": "cornerRadius",
      "label": "Corner radius",
      "type": "range",
      "default": 4,
      "min": 0,
      "max": 22,
      "step": 1
    },
    {
      "key": "fontScale",
      "label": "Typography scale",
      "type": "range",
      "default": 0.82,
      "min": 0.65,
      "max": 1.25,
      "step": 0.05
    }
  ]
}
