{
  "schemaVersion": 1,
  "id": "com.apexhud.fuel",
  "name": "Fuel Strategy",
  "description": "Premium fuel strategy display with remaining fuel, learned consumption, estimated laps and refill target.",
  "version": "3.0.0",
  "author": "ApexHUD",
  "entry": "index.html",
  "scopes": [
    "fuel"
  ],
  "defaultBounds": {
    "x": 0.78,
    "y": 0.79,
    "width": 0.2,
    "height": 0.15
  },
  "minimumSize": {
    "width": 270,
    "height": 130
  },
  "settings": [
    {
      "key": "safetyMargin",
      "label": "Visual safety margin",
      "type": "range",
      "default": 0.2,
      "min": 0,
      "max": 2,
      "step": 0.1,
      "help": "Added to the displayed refill estimate."
    },
    {
      "key": "accent",
      "label": "Accent",
      "type": "color",
      "default": "#f2c94c"
    },
    {
      "key": "opacity",
      "label": "Panel opacity",
      "type": "range",
      "default": 0.92,
      "min": 0.3,
      "max": 1,
      "step": 0.05
    }
  ]
}
