{
  "schemaVersion": 1,
  "id": "com.apexhud.inputs",
  "name": "Driver Inputs",
  "description": "Live steering and pedal bars combined with compact scrolling input traces.",
  "version": "4.0.0",
  "author": "ApexHUD",
  "entry": "index.html",
  "scopes": [
    "vehicle"
  ],
  "defaultBounds": {
    "x": 0.16,
    "y": 0.79,
    "width": 0.19,
    "height": 0.17
  },
  "minimumSize": {
    "width": 260,
    "height": 140
  },
  "settings": [
    {
      "key": "throttleColor",
      "label": "Throttle line",
      "type": "color",
      "default": "#42d36f"
    },
    {
      "key": "brakeColor",
      "label": "Brake line",
      "type": "color",
      "default": "#ff5252"
    },
    {
      "key": "clutchColor",
      "label": "Clutch line",
      "type": "color",
      "default": "#d8dde5"
    },
    {
      "key": "showClutch",
      "label": "Show clutch trace",
      "type": "boolean",
      "default": true
    },
    {
      "key": "historySeconds",
      "label": "Visible history",
      "type": "range",
      "default": 4,
      "min": 1,
      "max": 10,
      "step": 1,
      "help": "Approximate seconds of input history shown on the graph."
    },
    {
      "key": "lineWidth",
      "label": "Line width",
      "type": "range",
      "default": 1.8,
      "min": 1,
      "max": 4,
      "step": 0.2
    },
    {
      "key": "opacity",
      "label": "Panel opacity",
      "type": "range",
      "default": 0.9,
      "min": 0.2,
      "max": 1,
      "step": 0.05
    }
  ]
}
