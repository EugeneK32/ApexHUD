{
  "schemaVersion": 1,
  "id": "com.apexhud.incidents",
  "name": "Incidents",
  "description": "Incident counter with clear severity state and driver warning messaging.",
  "version": "2.0.0",
  "author": "ApexHUD",
  "entry": "index.html",
  "scopes": [
    "player"
  ],
  "defaultBounds": {
    "x": 0.185,
    "y": 0.035,
    "width": 0.1,
    "height": 0.13
  },
  "minimumSize": {
    "width": 160,
    "height": 105
  },
  "settings": [
    {
      "key": "hideAtZero",
      "label": "Hide at zero incidents",
      "type": "boolean",
      "default": false
    },
    {
      "key": "warningAt",
      "label": "Warning threshold",
      "type": "number",
      "default": 8,
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "key": "dangerAt",
      "label": "Danger threshold",
      "type": "number",
      "default": 12,
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "key": "opacity",
      "label": "Panel opacity",
      "type": "range",
      "default": 0.92,
      "min": 0.2,
      "max": 1,
      "step": 0.05
    }
  ]
}
