{
  "schemaVersion": 1,
  "id": "com.apexhud.incidents",
  "name": "Incident Monitor",
  "description": "Incident count, configurable limit, remaining allowance and escalating warnings.",
  "version": "5.1.0",
  "author": "Eugene Konovalov",
  "entry": "index.html",
  "scopes": [
    "player"
  ],
  "defaultBounds": {
    "x": 0.88,
    "y": 0.78,
    "width": 0.1,
    "height": 0.1
  },
  "minimumSize": {
    "width": 120,
    "height": 74
  },
  "settings": [
    {
      "key": "incidentLimit",
      "label": "Incident limit",
      "type": "number",
      "default": 17,
      "min": 0,
      "max": 100,
      "step": 1,
      "help": "Set to 0 when the session has no known disqualification limit."
    },
    {
      "key": "warningAt",
      "label": "Warning starts at",
      "type": "number",
      "default": 8,
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "key": "dangerAt",
      "label": "Danger starts at",
      "type": "number",
      "default": 13,
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "key": "showRemaining",
      "label": "Show incidents remaining",
      "type": "boolean",
      "default": true
    },
    {
      "key": "flashOnIncrease",
      "label": "Pulse when count increases",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showDemoInEditor",
      "label": "Show demo data in editor",
      "type": "boolean",
      "default": true
    },
    {
      "key": "panelColor",
      "label": "Panel color",
      "type": "color",
      "default": "#08090b"
    },
    {
      "key": "panelOpacity",
      "label": "Panel opacity",
      "type": "range",
      "default": 0.94,
      "min": 0.2,
      "max": 1,
      "step": 0.02
    },
    {
      "key": "cleanColor",
      "label": "Clean color",
      "type": "color",
      "default": "#37d67a"
    },
    {
      "key": "warningColor",
      "label": "Warning color",
      "type": "color",
      "default": "#f2c94c"
    },
    {
      "key": "dangerColor",
      "label": "Danger color",
      "type": "color",
      "default": "#ff4d5e"
    },
    {
      "key": "textColor",
      "label": "Primary text color",
      "type": "color",
      "default": "#f7f7f8"
    },
    {
      "key": "mutedColor",
      "label": "Secondary text color",
      "type": "color",
      "default": "#8d9098"
    },
    {
      "key": "borderColor",
      "label": "Border color",
      "type": "color",
      "default": "#2c2f35"
    },
    {
      "key": "cornerRadius",
      "label": "Corner radius",
      "type": "range",
      "default": 4,
      "min": 0,
      "max": 22,
      "step": 1
    },
    {
      "key": "fontScale",
      "label": "Typography scale",
      "type": "range",
      "default": 0.82,
      "min": 0.65,
      "max": 1.25,
      "step": 0.05
    }
  ]
}
