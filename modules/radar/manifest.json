{
  "schemaVersion": 1,
  "id": "com.apexhud.radar",
  "name": "Proximity Radar",
  "description": "Transparent side-by-side warning that appears only when another car is alongside.",
  "version": "3.2.0",
  "author": "ApexHUD",
  "entry": "index.html",
  "scopes": [
    "connection",
    "session",
    "player",
    "radar"
  ],
  "defaultBounds": {
    "x": 0.46,
    "y": 0.74,
    "width": 0.08,
    "height": 0.1
  },
  "minimumSize": {
    "width": 100,
    "height": 72
  },
  "settings": [
    {
      "key": "scale",
      "label": "Radar size",
      "type": "range",
      "default": 1,
      "min": 0.75,
      "max": 1.3,
      "step": 0.05
    },
    {
      "key": "approachDistance",
      "label": "Detection range",
      "type": "range",
      "default": 16,
      "min": 8,
      "max": 30,
      "step": 1,
      "help": "How far ahead or behind a car may be before the radar starts tracking it."
    },
    {
      "key": "accent",
      "label": "Player car",
      "type": "color",
      "default": "#e5e7eb"
    },
    {
      "key": "nearby",
      "label": "Car alongside color",
      "type": "color",
      "default": "#f2c94c"
    },
    {
      "key": "danger",
      "label": "Danger car color",
      "type": "color",
      "default": "#ef4444",
      "help": "Used when another car is deeply alongside yours. \u201cOverlap\u201d means how much of both cars are side by side."
    },
    {
      "key": "opacity",
      "label": "Radar opacity",
      "type": "range",
      "default": 0.94,
      "min": 0.35,
      "max": 1,
      "step": 0.05
    }
  ]
}
