{
  "schemaVersion": 1,
  "id": "com.apexhud.radar",
  "name": "Proximity Radar",
  "description": "Top-down side-contact radar with approach range, threat depth and stable editor preview.",
  "version": "5.1.0",
  "author": "Eugene Konovalov",
  "entry": "index.html",
  "scopes": [
    "radar"
  ],
  "defaultBounds": {
    "x": 0.445,
    "y": 0.65,
    "width": 0.11,
    "height": 0.2
  },
  "minimumSize": {
    "width": 130,
    "height": 150
  },
  "settings": [
    {
      "key": "showApproach",
      "label": "Show fast-approach contacts",
      "type": "boolean",
      "default": true
    },
    {
      "key": "rangeMeters",
      "label": "Visible range in metres",
      "type": "range",
      "default": 18,
      "min": 8,
      "max": 40,
      "step": 1
    },
    {
      "key": "carScale",
      "label": "Car size",
      "type": "range",
      "default": 1,
      "min": 0.7,
      "max": 1.4,
      "step": 0.05
    },
    {
      "key": "showLabels",
      "label": "Show LEFT / RIGHT status",
      "type": "boolean",
      "default": true
    },
    {
      "key": "showDemoInEditor",
      "label": "Show demo data in editor",
      "type": "boolean",
      "default": true
    },
    {
      "key": "panelColor",
      "label": "Panel color",
      "type": "color",
      "default": "#08090b"
    },
    {
      "key": "panelOpacity",
      "label": "Panel opacity",
      "type": "range",
      "default": 0.62,
      "min": 0,
      "max": 1,
      "step": 0.02
    },
    {
      "key": "playerColor",
      "label": "Player car color",
      "type": "color",
      "default": "#f7f7f8"
    },
    {
      "key": "nearbyColor",
      "label": "Nearby car color",
      "type": "color",
      "default": "#f2c94c"
    },
    {
      "key": "dangerColor",
      "label": "Overlapping car color",
      "type": "color",
      "default": "#ff4d5e"
    },
    {
      "key": "approachColor",
      "label": "Fast approach color",
      "type": "color",
      "default": "#b05cff"
    },
    {
      "key": "guideColor",
      "label": "Guide line color",
      "type": "color",
      "default": "#4c5058"
    },
    {
      "key": "textColor",
      "label": "Status text color",
      "type": "color",
      "default": "#f7f7f8"
    },
    {
      "key": "cornerRadius",
      "label": "Corner radius",
      "type": "range",
      "default": 4,
      "min": 0,
      "max": 26,
      "step": 1
    }
  ]
}
